# ========================================================
# AgroSeed High-Performance Apache & Cloudflare Configuration
# Supercharges cPanel API response speed & enables Gzip
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# 1. Enable GZIP / Deflate Compression (Reduces JSON payload size by 70-85%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 2. Enable HTTP Keep-Alive for fast connection reuse
<IfModule mod_headers.c>
    Header set Connection keep-alive
    Header append Vary "Accept-Encoding"
</IfModule>

# 3. Leverage Browser & Cloudflare Edge Caching strictly for static images & media
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# 4. Strictly prevent caching and public direct reading of internal JSON database files
<FilesMatch "\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>


# 5. Security & Optimization
Options -Indexes
ServerSignature Off
