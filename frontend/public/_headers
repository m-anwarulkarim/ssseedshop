# Static JS/CSS assets — cache for 1 year (Vite adds content hash to filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images
/*.webp
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# Favicon
/favicon.png
  Cache-Control: public, max-age=86400

# HTML pages — always revalidate (no cache for HTML)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
