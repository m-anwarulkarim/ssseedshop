{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agro-seed-php",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
